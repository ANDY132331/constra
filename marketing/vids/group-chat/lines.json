  { "who": "Mac", "kind": "msg", "voice": "en-US-AndrewMultilingualNeural", "rate": "+2%", "gap": 0.8, "text": "Clock in with a photo and G P S. The timesheets build themselves. P D F or Excel, overtime included." },
