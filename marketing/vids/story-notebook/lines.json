[
  { "who": "Mac", "voice": "en-US-AndrewMultilingualNeural", "rate": "+2%", "gap": 0.5, "text": "Okay, crew. It's Friday. Payroll day. Who worked Tuesday?" },
  { "who": "Jess", "voice": "en-US-AvaMultilingualNeural", "rate": "+8%", "gap": 0.4, "text": "Me. Queen Street. Eight hours." },
  { "who": "Dev", "voice": "en-US-BrianMultilingualNeural", "rate": "+6%", "gap": 0.3, "text": "Me too!" },
  { "who": "Jess", "voice": "en-US-AvaMultilingualNeural", "rate": "+6%", "gap": 0.3, "text": "Dev, you were at Dundas." },
  { "who": "Dev", "voice": "en-US-BrianMultilingualNeural", "rate": "+4%", "gap": 0.5, "text": "I was at both. I'm very fast." },
  { "who": "Mac", "voice": "en-US-AndrewMultilingualNeural", "rate": "-2%", "gap": 0.5, "text": "Dev. Show me your notebook." },
  { "who": "Dev", "voice": "en-US-BrianMultilingualNeural", "rate": "-6%", "gap": 0.9, "text": "It's, uh... in a better place." },
  { "who": "Mac", "voice": "en-US-AndrewMultilingualNeural", "rate": "+0%", "gap": 0.6, "text": "Is that a bite mark?" },
  { "who": "Dev", "voice": "en-US-BrianMultilingualNeural", "rate": "+4%", "gap": 0.4, "text": "The truck's dog had some thoughts about Tuesday." },
  { "who": "Mac", "voice": "en-US-AndrewMultilingualNeural", "rate": "+10%", "gap": 0.5, "text": "I can't run payroll on a feeling!" },
  { "who": "Jess", "voice": "en-US-AvaMultilingualNeural", "rate": "+4%", "gap": 0.9, "text": "Boss. Try this. It's called Constra. You clock in with a photo and G P S." },
  { "who": "Mac", "voice": "en-US-AndrewMultilingualNeural", "rate": "+0%", "gap": 0.5, "text": "A photo?" },
  { "who": "Jess", "voice": "en-US-AvaMultilingualNeural", "rate": "+4%", "gap": 0.4, "text": "Every shift. Who, where, and when. And the timesheets build themselves." },
  { "who": "Dev", "voice": "en-US-BrianMultilingualNeural", "rate": "-2%", "gap": 0.6, "text": "So it knows I wasn't at Queen Street." },
  { "who": "Jess", "voice": "en-US-AvaMultilingualNeural", "rate": "+4%", "gap": 0.4, "text": "It knows." },
  { "who": "Dev", "voice": "en-US-BrianMultilingualNeural", "rate": "+2%", "gap": 0.5, "text": "I hate that. I love it. I hate it." },
  { "who": "Jess", "voice": "en-US-AvaMultilingualNeural", "rate": "+4%", "gap": 0.6, "text": "Overtime is already worked out. P D F or Excel. One tap." },
  { "who": "Mac", "voice": "en-US-AndrewMultilingualNeural", "rate": "+0%", "gap": 0.5, "text": "And when there's no signal?" },
  { "who": "Jess", "voice": "en-US-AvaMultilingualNeural", "rate": "+4%", "gap": 0.4, "text": "It saves on the phone, and syncs when you're back online." },
  { "who": "Mac", "voice": "en-US-AndrewMultilingualNeural", "rate": "-2%", "gap": 0.7, "text": "So I get my Fridays back." },
  { "who": "Dev", "voice": "en-US-BrianMultilingualNeural", "rate": "+0%", "gap": 0.5, "text": "And I get my notebook back?" },
  { "who": "Jess", "voice": "en-US-AvaMultilingualNeural", "rate": "+2%", "gap": 0.4, "text": "Dev. It's gone." },
  { "who": "Dev", "voice": "en-US-BrianMultilingualNeural", "rate": "-8%", "gap": 0.6, "text": "Rest well, buddy." },
  { "who": "Mac", "voice": "en-US-AndrewMultilingualNeural", "rate": "-2%", "gap": 0.8, "text": "Constra. Free while it's launching. Run the job, not the paperwork." }
]
