{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "construction-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "constra-offline",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "env": { "NEXT_PUBLIC_SUPABASE_URL": "" }
    },
    {
      "name": "constra-sync-test",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3006", "-H", "127.0.0.1"],
      "port": 3006,
      "env": { "NEXT_PUBLIC_SUPABASE_URL": "http://127.0.0.1:54399", "NEXT_PUBLIC_SUPABASE_ANON_KEY": "test", "SUPABASE_SERVICE_ROLE_KEY": "test" }
    }
  ]
}
